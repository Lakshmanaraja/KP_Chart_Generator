import swisseph as swe
import pandas as pd

from datetime import datetime, timedelta


# ==========================================================
# CONFIGURATION
# ==========================================================

EPHE_PATH = "ephe"

START_DATE = datetime(1926, 1, 1)
END_DATE   = datetime(2126, 1, 1)

INTERVAL_HOURS = 6


swe.set_ephe_path(EPHE_PATH)

# Lahiri ayanamsa
swe.set_sid_mode(swe.SIDM_LAHIRI)


# ==========================================================
# PLANETS
# ==========================================================

PLANETS = {

    "Sun": swe.SUN,
    "Moon": swe.MOON,
    "Mercury": swe.MERCURY,
    "Venus": swe.VENUS,
    "Mars": swe.MARS,
    "Jupiter": swe.JUPITER,
    "Saturn": swe.SATURN,
    "Rahu": swe.MEAN_NODE

}


# ==========================================================
# CONSTANTS
# ==========================================================


RASHIS = [
    "Aries",
    "Taurus",
    "Gemini",
    "Cancer",
    "Leo",
    "Virgo",
    "Libra",
    "Scorpio",
    "Sagittarius",
    "Capricorn",
    "Aquarius",
    "Pisces"
]


NAKSHATRAS = [
    "Ashwini",
    "Bharani",
    "Krittika",
    "Rohini",
    "Mrigashira",
    "Ardra",
    "Punarvasu",
    "Pushya",
    "Ashlesha",
    "Magha",
    "Purva Phalguni",
    "Uttara Phalguni",
    "Hasta",
    "Chitra",
    "Swati",
    "Vishakha",
    "Anuradha",
    "Jyeshta",
    "Mula",
    "Purva Ashadha",
    "Uttara Ashadha",
    "Shravana",
    "Dhanishta",
    "Shatabhisha",
    "Purva Bhadrapada",
    "Uttara Bhadrapada",
    "Revati"
]


NAK_SIZE = 360 / 27


# ==========================================================
# STORAGE
# ==========================================================

positions = []
events = []


previous = {}


# ==========================================================
# HELPER
# ==========================================================

def get_position(planet_id, jd):

    xx, flag = swe.calc_ut(
        jd,
        planet_id,
        swe.FLG_SWIEPH |
        swe.FLG_SPEED |
        swe.FLG_SIDEREAL
    )

    longitude = xx[0] % 360

    speed = xx[3]

    retro = speed < 0

    return longitude, speed, retro



def get_details(longitude):

    rasi_index = int(longitude // 30)

    nak_index = int(longitude // NAK_SIZE)

    pada = int(
        (longitude % NAK_SIZE)
        /
        (NAK_SIZE / 4)
    ) + 1


    return (
        rasi_index,
        RASHIS[rasi_index],
        nak_index,
        NAKSHATRAS[nak_index],
        pada
    )


# ==========================================================
# MAIN LOOP
# ==========================================================

current = START_DATE


while current <= END_DATE:


    jd = swe.julday(
        current.year,
        current.month,
        current.day,
        current.hour +
        current.minute/60
    )


    for planet, pid in PLANETS.items():


        longitude, speed, retro = get_position(pid, jd)


        rasi, rasi_name, nak, nak_name, pada = \
            get_details(longitude)



        # -----------------------------
        # TABLE 1
        # -----------------------------

        positions.append({

            "planet":planet,

            "utc_datetime":
            current.isoformat(),

            "julian_day":
            jd,

            "longitude":
            round(longitude,6),

            "speed":
            round(speed,8),

            "retrograde":
            retro,

            "rasi":
            rasi,

            "rasi_name":
            rasi_name,

            "nakshatra":
            nak,

            "nakshatra_name":
            nak_name,

            "pada":
            pada

        })



        # -----------------------------
        # TABLE 2 EVENTS
        # -----------------------------


        key = planet


        if key in previous:


            old = previous[key]


            # RASI CHANGE

            if old["rasi"] != rasi:

                events.append({

                    "planet":planet,

                    "event_datetime":
                    current.isoformat(),

                    "julian_day":jd,

                    "longitude":
                    longitude,

                    "event_type":
                    "RASI",

                    "previous_value":
                    old["rasi_name"],

                    "current_value":
                    rasi_name

                })



            # NAKSHATRA CHANGE

            if old["nak"] != nak:

                events.append({

                    "planet":planet,

                    "event_datetime":
                    current.isoformat(),

                    "julian_day":jd,

                    "longitude":
                    longitude,

                    "event_type":
                    "NAKSHATRA",

                    "previous_value":
                    old["nak_name"],

                    "current_value":
                    nak_name

                })



            # PADA CHANGE

            if old["pada"] != pada:

                events.append({

                    "planet":planet,

                    "event_datetime":
                    current.isoformat(),

                    "julian_day":
                    jd,

                    "longitude":
                    longitude,

                    "event_type":
                    "PADA",

                    "previous_value":
                    old["pada"],

                    "current_value":
                    pada

                })



            # RETRO CHANGE

            if old["retro"] != retro:

                events.append({

                    "planet":planet,

                    "event_datetime":
                    current.isoformat(),

                    "julian_day":
                    jd,

                    "longitude":
                    longitude,

                    "event_type":
                    "RETROGRADE",

                    "previous_value":
                    old["retro"],

                    "current_value":
                    retro

                })



        previous[key] = {

            "rasi":
            rasi,

            "rasi_name":
            rasi_name,

            "nak":
            nak,

            "nak_name":
            nak_name,

            "pada":
            pada,

            "retro":
            retro

        }



    current += timedelta(hours=INTERVAL_HOURS)



# ==========================================================
# SAVE
# ==========================================================

positions_df = pd.DataFrame(positions)

events_df = pd.DataFrame(events)


positions_df.to_csv(
    "planet_positions.csv",
    index=False
)


events_df.to_csv(
    "planet_events.csv",
    index=False
)



print("Positions rows:",
      len(positions_df))


print("Events rows:",
      len(events_df))


print("Completed")